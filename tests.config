// Config for the fastp tests that run the tool for real, rather than checking
// stub wiring.
//
// conf/module.config pins :v0.0.0, which only exists once this module is
// released, so the tests track :latest instead - the same reason the consuming
// pipeline carries a `dev` profile.
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: FASTP_TRIM {
        container = 'ghcr.io/eit-gbi/nf-mod-fastp:latest'
        cpus      = 1
    }
}
